# Normalize text files in the repository by default.
* text=auto

# Source files and Gradle configuration should stay LF across platforms.
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Common project metadata and documentation.
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Scripts.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets and archives.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary
